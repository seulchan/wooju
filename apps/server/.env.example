# Wooju — local server configuration.
#
# Copy this file to `.env` (in this apps/server/ directory) and edit it:
#   cp .env.example .env
#
# `.env` is gitignored and never committed. Values here are loaded at startup
# (see app/config.py). A real environment variable always takes precedence over
# a value in this file, so explicit `export WOOJU_BRAIN_PATH=...` still wins.

# Absolute path to your Wooju Brain directory (a directory; empty is fine).
# Example:
#   WOOJU_BRAIN_PATH=/Users/chan/Documents/wooju-brain
WOOJU_BRAIN_PATH=
